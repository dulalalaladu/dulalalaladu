<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main car icon centered and larger -->
    <group
        android:translateX="54"
        android:translateY="54">

        <!-- Car body -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M-20,-8 L-20,8 L20,8 L20,-8 Z M-18,-10 L18,-10 L20,-8 L-20,-8 Z" />

        <!-- Car windows -->
        <path
            android:fillColor="#1565C0"
            android:pathData="M-15,-6 L-8,-6 L-8,2 L-15,2 Z M8,-6 L15,-6 L15,2 L8,2 Z" />

        <!-- Car wheels -->
        <path
            android:fillColor="#455A64"
            android:pathData="M-15,8 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
        <path
            android:fillColor="#455A64"
            android:pathData="M15,8 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />

        <!-- Inner wheels (rims) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M-15,8 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M15,8 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />

        <!-- Search magnifying glass (top right) -->
        <group
            android:translateX="18"
            android:translateY="-18"
            android:scaleX="0.5"
            android:scaleY="0.5">

            <!-- Magnifying glass circle -->
            <path
                android:fillColor="#FF9800"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="2"
                android:pathData="M0,0 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />

            <!-- Magnifying glass handle -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M6,6 L12,12"
                android:strokeColor="#FFFFFF"
                android:strokeWidth="3"
                android:strokeLineCap="round" />
        </group>
    </group>
</vector>
